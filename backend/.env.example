# Snowflake Connection Parameters
# Copy this file to .env and fill in your own values

SNOWFLAKE_ACCOUNT="YOUR_ACCOUNT_IDENTIFIER"   # e.g., xy12345.ap-northeast-2.aws
SNOWFLAKE_USER="YOUR_USERNAME"
SNOWFLAKE_PASSWORD="YOUR_PASSWORD"
SNOWFLAKE_ROLE=your_least_privilege_role
SNOWFLAKE_WAREHOUSE="COMPUTE_WH"             # your active warehouse name

# Snowflake Marketplace Database Names
# These must be the exact names of the databases mounted to your account
SNOWFLAKE_DB_RICHGO="YOUR_RICHGO_DATABASE_NAME"
SNOWFLAKE_DB_AJD="YOUR_AJD_DATABASE_NAME"
SNOWFLAKE_DB_SPH="YOUR_SPH_DATABASE_NAME"
SNOWFLAKE_SCHEMA="PUBLIC"

# Private demo API access: random code, at least 32 characters. Never use NEXT_PUBLIC_.
DEMO_ACCESS_TOKEN=
ALLOW_LOCAL_DEMO=false
ALLOWED_ORIGINS=http://localhost:3000

